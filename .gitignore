node_modules/

# Secrets — never commit
.env
.env.*
!.env.example

# SQLite databases and backups: development data stays local, production data
# lives on the server's persistent volume. Neither belongs in the repository.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db*
backups/
*.bak
*.dump

.DS_Store

# Private testing photos. Real photos taken on a personal phone are not
# redistributable; the synthetic fixtures beside them are generated by
# make-fixture.mjs and are safe to publish. Tests that need the real photos
# skip themselves when the files are absent.
tests/fixtures/IMG_*

# Diagnostic logs and other transient development artefacts
*.log
nohup.out
logs/
tmp/
.cache/

# Editor and tool state
.vscode/
.idea/
.claude/

# Design reference artwork, kept locally. The app's own asset is public/logo.png.
Eco Chat Recycling Icon*.png

# Raw screenshot captures. They are embedded as base64 inside report.html and
# slides.html, so the deliverables stay self-contained without the originals.
WasteWise Screenshots/
