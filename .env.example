# Copy to .env and fill in. .env is gitignored — never commit a real key.
# If you are working inside the course folder, a PORTKEY_API_KEY in a parent
# directory's .env is picked up automatically (see server/env.js).

# --- Provider selection -----------------------------------------------------
# "portkey" (course gateway, default when PORTKEY_API_KEY is set) or "anthropic".
# LLM_PROVIDER=portkey

# --- Portkey (course-provided) ----------------------------------------------
PORTKEY_API_KEY=
PORTKEY_MODEL=gpt-6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai

# --- Anthropic (alternative provider) ---------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# --- Cost estimation --------------------------------------------------------
# Per-million-token rates, used ONLY to estimate cost for the report. Token
# counts are always exact; these turn them into dollars.
#
# OpenAI's published list price for gpt-6-luna (developers.openai.com pricing
# page, retrieved 2026-10-16): $0.10 input / $0.01 cached input / $0.50 output.
# These are LIST PRICES for the model. This app reaches the model through the
# course's Portkey gateway, so the figures below are an estimate of list-price
# cost, not a record of what was actually billed to anyone.
#
# Leave unset and estimated_cost_usd stays null rather than guessing.
# PRICE_INPUT_PER_MTOK=0.10
# PRICE_CACHED_INPUT_PER_MTOK=0.01
# PRICE_OUTPUT_PER_MTOK=0.50

# --- Environment separation --------------------------------------------------
# Where SQLite lives. Development keeps its own file; production points at a
# path on a persistent volume so data survives restarts and redeploys.
#   development:  ./data/wastewise.db   (the default, and gitignored)
#   production:   /var/data/wastewise.db
# A fresh file is created and migrated automatically on first run — development
# records are never copied into it.
# DB_PATH=./data/wastewise.db

# Which cohort new traffic is recorded as. Defaults to "development" locally and
# "public" when NODE_ENV=production. Set explicitly only if you need to override.
# DEFAULT_COHORT=public

# Short code that marks a structured student-evaluation session. Share the link
# /eval?code=THIS_CODE with recruited participants; their questions are then
# recorded as student evaluation. It is NOT an admin credential and grants no
# access. Leave blank to disable evaluation tagging.
EVAL_ACCESS_CODE=

# --- Operations dashboard (admin only) --------------------------------------
# Required to enable /admin. Without it the dashboard stays switched off.
# Use a long random value, e.g.  openssl rand -base64 24
ADMIN_PASSWORD=
# Optional: keeps admin sessions valid across restarts. 16+ chars.
# Without it a random key is generated at startup, so a restart signs you out.
ADMIN_SESSION_SECRET=
# ADMIN_SESSION_HOURS=8
# Sign-in attempts allowed per IP, and the window they are counted over.
# ADMIN_LOGIN_MAX=5
# ADMIN_LOGIN_WINDOW_MS=900000
# How many observations before a pattern is surfaced as an opportunity.
# OPPORTUNITY_MIN_OBSERVATIONS=3

PORT=3000
# How many reverse-proxy hops sit in front of the app. Defaults to 1 under
# NODE_ENV=production (one managed-host proxy) and 0 locally. Set this only if
# your host adds more: trusting more hops than really exist would let a client
# spoof its own address via X-Forwarded-For and evade the per-IP rate limits.
# TRUST_PROXY=1

# Loopback by default, and 0.0.0.0 automatically under NODE_ENV=production.
# Set HOST=0.0.0.0 locally only while testing on a phone over Wi-Fi.
# HOST=0.0.0.0
# Allow /api/usage from other machines (off by default, even in LAN mode).
# ALLOW_REMOTE_USAGE=1
DB_PATH=./data/wastewise.db
LLM_TIMEOUT_MS=120000

# --- Abuse / cost protection ------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
DAILY_REQUEST_CAP=300
MAX_QUESTION_CHARS=500
# Max accepted photo size in bytes (default 5 MB).
MAX_IMAGE_BYTES=5242880
